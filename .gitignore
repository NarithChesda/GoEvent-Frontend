!CLAUDE.md
!DESIGN.md
!docs/**/*.md
!src/**/*.md
DESIGN_GUIDE/
# Claude Code: keep local settings private, but version project skills
.claude/*
!.claude/skills/
!.claude/skills/**

# Impeccable design detector: share rule config, keep local overrides private
.impeccable/config.local.json

# Environment Variables - Security Critical (exclude ALL .env files)
.env
.env.*
.env.local
.env.development
.env.production
.env.test
.env.*.local

