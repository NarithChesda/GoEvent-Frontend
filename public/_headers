# Security and performance headers for Cloudflare Pages

# Apply to all files
/*
  # Security headers
  # SAMEORIGIN, not DENY: the manage page's Design Studio renders the showcase
  # in same-origin <iframe>s (/events/:id/showcase-preview-frame). DENY blocks
  # those too, so the previews show "refused to connect" in production while
  # working in dev (the Vite dev server never applies this file).
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: frame-ancestors 'self'
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

  # Cache control for HTML (no cache)
  Cache-Control: no-cache, no-store, must-revalidate

# Long-lived caching for fingerprinted and static files.
#
# Pages MERGES every rule that matches a path, joining repeated headers with a
# comma, so without the `! Cache-Control` detach each of these inherited
# `no-cache, no-store` from /* above and went out as
# `no-cache, no-store, must-revalidate, public, max-age=31536000, immutable`
# — no-store wins, and browsers re-downloaded the whole bundle on every visit
# (seen on production, 2026-09-19). The detach drops the inherited value first.

# Cache static assets for 1 year
/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Cache images
/images/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Fonts need no rule of their own: Vite fingerprints them into /assets/fonts/,
# which /assets/* covers. (There were `*.woff2`-style rules here; a rule must
# start with `/`, so Pages read each as a malformed header line of the rule
# above it and they never applied.)

# Don't cache service worker
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
